    "import pandas as pd\n",
    "\n",
    "df=pd.read_csv(\"employee_data.csv\")\n",
    "print(df)\n",
    "\n",
    "df[df[\"Salary\"]>75000] # filter salary greater than 75000\n",
    "df[(df[\"Salary\"]>75000) & (df[\"Age\"]>42)]\n",
    "\n",
    "df[df[\"Age\"]>22][[\"Name\",\"Age\"]]"
   ]
